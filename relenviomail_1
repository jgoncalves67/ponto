<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SE &amp; S — Relatório de Assistência</title>

<style>
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    color: #103a6b;
    margin: 0;
    padding: 0;
    background: #e8ebef;
  }

  .barra-botoes {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #103a6b;
    padding: 8px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.2);
  }

  .barra-botoes button {
    width: auto;
    padding: 10px 14px;
    font-size: 13px;
    margin: 0;
  }

  button {
    background: #103a6b;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    touch-action: manipulation;
  }

  .btn-verde { background: #1a7a3d; }
  .btn-cinza { background: #5a6a7a; }
  .btn-laranja { background: #d4820a; }
  .btn-vermelho { background: #b02a2a; }

  /* Folha do relatório */
  .folha {
    width: calc(100% - 24px);
    max-width: 820px;
    margin: 12px auto;
    background: #fff;
    padding: 16px;
    border: 1px solid #ccc;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
  }

  .topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }

  .topo > * {
    min-width: 0;
  }

  .logo {
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .logo-sub {
    font-size: 9px;
    font-weight: bold;
    line-height: 1.4;
  }

  .titulo {
    text-align: center;
    font-size: 19px;
    font-weight: bold;
    line-height: 1.15;
  }

  .contactos {
    text-align: right;
    font-size: 9px;
    line-height: 1.4;
  }

  .contactos a {
    color: inherit;
    text-decoration: none;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-top: 5px;
  }

  td {
    border: 1px solid #b7c7de;
    padding: 3px 5px;
    vertical-align: middle;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .barra {
    background: #dbe5f1;
    font-weight: bold;
    text-align: center;
    padding: 4px;
    border: 1px solid #b7c7de;
    margin-top: 5px;
    font-size: 12px;
  }

  .rot {
    font-weight: bold;
    background: #f4f7fb;
  }

  input[type="text"],
  input[type="email"],
  input[type="date"],
  input[type="time"],
  textarea {
    display: inline-block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border: none;
    outline: none;
    font-size: 12px;
    color: #103a6b;
    background: transparent;
    font-family: inherit;
    padding: 2px;
  }

  input[type="checkbox"] {
    width: auto;
    max-width: none;
    margin-right: 3px;
  }

  textarea {
    display: block;
    min-height: 120px;
    resize: vertical;
    font-size: 12px;
    line-height: 1.4;
    white-space: pre-wrap;
  }

  .chk {
    white-space: nowrap;
    margin-right: 12px;
    display: inline-block;
    padding: 2px 0;
    font-size: 12px;
  }

  .chk input {
    width: auto;
    margin-right: 3px;
  }

  .assin {
    display: flex;
    gap: 8px;
    margin-top: 5px;
  }

  .assin-box {
    flex: 1;
    min-width: 0;
    border: 1px solid #b7c7de;
  }

  .assin-box .cab {
    background: #dbe5f1;
    font-weight: bold;
    text-align: center;
    padding: 4px;
    border-bottom: 1px solid #b7c7de;
    font-size: 12px;
  }

  canvas {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 75px;
    touch-action: none;
    background: #fff;
  }

  .assin-box .nome {
    border-top: 1px solid #b7c7de;
  }

  .assin-box .nome input {
    text-align: center;
    color: #666;
  }

  .btn-limpar {
    width: 100%;
    padding: 4px;
    font-size: 10px;
    margin: 0;
    background: #eef3f9;
    color: #103a6b;
    border: none;
    border-radius: 0;
    font-weight: normal;
  }

  .rodape {
    font-size: 8px;
    color: #555;
    margin-top: 8px;
    line-height: 1.4;
  }

  #painelRel {
    width: calc(100% - 24px);
    max-width: 820px;
    margin: 10px auto;
    background: #fff;
    border-radius: 10px;
    padding: 15px;
    display: none;
    box-shadow: 0 1px 4px rgba(0,0,0,.15);
  }

  .rel-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    border-bottom: 1px solid #eee;
    gap: 8px;
  }

  .rel-item .info {
    flex: 1;
    min-width: 0;
    font-size: 14px;
  }

  .rel-item .info small {
    color: #777;
    display: block;
  }

  .rel-item button {
    width: auto;
    padding: 6px 12px;
    font-size: 12px;
    margin: 0 0 0 5px;
  }

  .aviso-email {
    font-size: 11px;
    color: #155724;
    background: #d4edda;
    border-radius: 6px;
    padding: 8px;
    margin-top: 10px;
    text-align: center;
  }

  /* Mensagem enquanto é gerado o PDF */
  #overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(16,58,107,.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    color: #fff;
    font-size: 18px;
    font-weight: bold;
    flex-direction: column;
    gap: 10px;
    text-align: center;
    padding: 20px;
  }

  @page {
    size: A4;
    margin: 8mm;
  }

  /* Ajustes para telemóveis */
  @media screen and (max-width: 640px) {
    .barra-botoes {
      padding: 6px;
      gap: 5px;
    }

    .barra-botoes button {
      flex: 1 1 calc(33.333% - 6px);
      min-width: 88px;
      padding: 9px 5px;
      font-size: 12px;
    }

    .folha {
      width: calc(100% - 12px);
      margin: 6px auto;
      padding: 10px;
    }

    .topo {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: 6px;
    }

    .topo > div:first-child {
      grid-column: 1;
      grid-row: 1;
    }

    .topo .contactos {
      grid-column: 2;
      grid-row: 1;
      text-align: right;
      font-size: 8px;
      overflow-wrap: anywhere;
    }

    .topo .titulo {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 17px;
    }

    .logo {
      font-size: 22px;
    }

    .logo-sub {
      font-size: 8px;
      overflow-wrap: anywhere;
    }

    table {
      margin-top: 4px;
    }

    td {
      padding: 4px 3px;
      font-size: 10px;
    }

    .barra {
      padding: 4px 2px;
      font-size: 10px;
    }

    .rot {
      font-size: 10px;
    }

    input[type="text"],
    input[type="email"],
    input[type="date"],
    input[type="time"],
    textarea {
      font-size: 11px;
      padding: 3px 2px;
    }

    input[type="date"],
    input[type="time"] {
      font-size: 10px;
    }

    .chk {
      white-space: normal;
      margin-right: 5px;
      font-size: 10px;
    }

    .chk input {
      margin-right: 2px;
    }

    .assin {
      gap: 5px;
    }

    .assin-box .cab {
      font-size: 10px;
      padding: 5px 2px;
    }

    canvas {
      height: 68px;
    }

    .rodape {
      font-size: 7px;
    }

    #painelRel {
      width: calc(100% - 12px);
      margin: 8px auto;
      padding: 10px;
    }

    .rel-item {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .rel-item .info {
      flex: 1 1 100%;
    }

    .rel-item button {
      margin: 0;
    }
  }

  /* Ecrãs muito estreitos: cabeçalho e assinaturas empilhados */
  @media screen and (max-width: 380px) {
    .topo {
      grid-template-columns: minmax(0, 1fr);
    }

    .topo > div:first-child {
      grid-column: 1;
      grid-row: 1;
      text-align: center;
    }

    .topo .titulo {
      grid-column: 1;
      grid-row: 2;
    }

    .topo .contactos {
      grid-column: 1;
      grid-row: 3;
      text-align: center;
    }

    .assin {
      flex-direction: column;
    }
  }

  @media print {
    body {
      background: #fff;
      overflow: visible;
    }

    .barra-botoes,
    #painelRel,
    .btn-limpar,
    .aviso-email,
    .botoes-fim,
    #overlay {
      display: none !important;
    }

    .folha {
      width: 100%;
      max-width: 100%;
      border: none;
      box-shadow: none;
      margin: 0;
      padding: 0;
    }
  }
</style>
</head>

