<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
const CAMPOS = [
  'pa','refCliente','nome','data','morada','localidade','codPostal','nif','email',
  'mPedido','mAssistencia','mContratoSim','mContratoNao','mOutros',
  'modelo','eqDescricao','numSerie','eqOutros',
  'tSADI','tSADIR','tVideoporteiro','tEletricidade','tCCTV','tAcessos','tPonto','tOutros',
  'scSim','scNao','numGuia','numCodAT','descServico','horaIni','horaFim',
  'nomeTecnico','nomeCliente'
];

let relId = null;

function v(id) {
  return (document.getElementById(id) || {}).value || '';
}

function dataFmt(d) {
  return d ? d.split('-').reverse().join('/') : '';
}

function escaparHTML(texto) {
  return String(texto == null ? '' : texto).replace(/[&<>"']/g, function(caractere) {
    return {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[caractere];
  });
}

/* Recolher e preencher campos */
function recolherDados() {
  const d = {};

  CAMPOS.forEach(function(id) {
    const el = document.getElementById(id);
    if (!el) return;

    d[id] = el.type === 'checkbox' ? el.checked : el.value;
  });

  d.assTec = document.getElementById('cvTec').toDataURL();
  d.assCli = document.getElementById('cvCli').toDataURL();

  return d;
}

function preencherDados(d) {
  CAMPOS.forEach(function(id) {
    const el = document.getElementById(id);
    if (!el || d[id] === undefined) return;

    if (el.type === 'checkbox') {
      el.checked = d[id];
    } else {
      el.value = d[id];
    }
  });

  desenharAssinatura('cvTec', d.assTec);
  desenharAssinatura('cvCli', d.assCli);
}

function desenharAssinatura(id, dataURL) {
  const cv = document.getElementById(id);
  const ctx = cv.getContext('2d');

  ctx.clearRect(0, 0, cv.width, cv.height);

  if (!dataURL) return;

  const img = new Image();

  img.onload = function() {
    ctx.clearRect(0, 0, cv.width, cv.height);
    ctx.drawImage(img, 0, 0, cv.width, cv.height);
  };

  img.src = dataURL;
}

/* Gravação automática de rascunho */
function guardarRascunho() {
  try {
    localStorage.setItem(
      'ra_rascunho',
      JSON.stringify({ relId: relId, dados: recolherDados() })
    );
  } catch (e) {
    console.warn('Não foi possível guardar o rascunho.', e);
  }
}

document.addEventListener('input', guardarRascunho);
document.addEventListener('change', guardarRascunho);

/* Lista de relatórios guardados */
function lista() {
  try {
    const dados = JSON.parse(localStorage.getItem('ra_relatorios') || '[]');
    return Array.isArray(dados) ? dados : [];
  } catch (e) {
    return [];
  }
}

function salvarLista(l) {
  localStorage.setItem('ra_relatorios', JSON.stringify(l));
}

function guardarRelatorio() {
  const dados = recolherDados();
  const l = lista();

  if (relId) {
    const i = l.findIndex(function(r) {
      return r.id === relId;
    });

    if (i >= 0) {
      l[i].dados = dados;
      l[i].gravadoEm = Date.now();
    } else {
      relId = 'r' + Date.now();
      l.push({ id: relId, dados: dados, gravadoEm: Date.now() });
    }
  } else {
    relId = 'r' + Date.now();
    l.push({ id: relId, dados: dados, gravadoEm: Date.now() });
  }

  salvarLista(l);
  guardarRascunho();
  renderLista();

  alert(
    '💾 Relatório guardado!\n\nCliente: ' +
    (dados.nome || '—') +
    '\nData: ' +
    dataFmt(dados.data)
  );
}

function renderLista() {
  const div = document.getElementById('listaRel');
  const l = lista().slice().reverse();

  if (l.length === 0) {
    div.innerHTML = '<div style="color:#888;padding:10px">Ainda não há relatórios guardados.</div>';
    return;
  }

  div.innerHTML = l.map(function(r) {
    const dados = r.dados || {};
    const id = String(r.id || '').replace(/[^a-zA-Z0-9_-]/g, '');
    const nome = escaparHTML(dados.nome || 'Sem nome');
    const data = escaparHTML(dataFmt(dados.data) || 'sem data');
    const pa = escaparHTML(dados.pa || '—');
    const guardado = new Date(r.gravadoEm).toLocaleString('pt-PT');

    return `
      <div class="rel-item">
        <div class="info">
          <b>${nome}</b> — ${data}
          <small>PA: ${pa} · Guardado: ${guardado}</small>
        </div>
        <div>
          <button class="btn-verde" onclick="abrirRelatorio('${id}')">Abrir</button>
          <button class="btn-vermelho" onclick="apagarRelatorio('${id}')">🗑️</button>
        </div>
      </div>
    `;
  }).join('');
}

function abrirRelatorio(id) {
  const r = lista().find(function(x) {
    return x.id === id;
  });

  if (!r) return;

  relId = id;
  preencherDados(r.dados || {});
  guardarRascunho();
  togglePainel(true);
  window.scrollTo(0, 0);
}

function apagarRelatorio(id) {
  if (!confirm('Apagar este relatório guardado?')) return;

  salvarLista(lista().filter(function(r) {
    return r.id !== id;
  }));

  renderLista();
}

function togglePainel(forcarFechar) {
  const painel = document.getElementById('painelRel');

  if (forcarFechar === true) {
    painel.style.display = 'none';
    return;
  }

  painel.style.display = painel.style.display === 'block' ? 'none' : 'block';

  if (painel.style.display === 'block') {
    renderLista();
  }
}

function novoRelatorio() {
  if (!confirm('Começar um relatório novo em branco?\n\n(O atual fica guardado se carregaste em 💾)')) {
    return;
  }

  relId = null;

  CAMPOS.forEach(function(id) {
    const el = document.getElementById(id);
    if (!el) return;

    if (el.type === 'checkbox') {
      el.checked = false;
    } else {
      el.value = '';
    }
  });

  document.getElementById('nomeTecnico').value = 'João Gonçalves';

  limparCanvas('cvTec');
  limparCanvas('cvCli');

  document.getElementById('data').valueAsDate = new Date();

  guardarRascunho();
  window.scrollTo(0, 0);
}

/* Gerar PDF: usa sempre o formato do relatório, mesmo quando aberto no telemóvel */
async function gerarPDF() {
  const folha = document.getElementById('folha');
  const estiloOriginal = folha.getAttribute('style');

  const assinaturas = [
    document.getElementById('cvTec').toDataURL(),
    document.getElementById('cvCli').toDataURL()
  ];

  /*
    O relatório é temporariamente colocado na largura normal de ecrã.
    Assim, o PDF não fica estreito ou desformatado por ter sido criado no telemóvel.
  */
  folha.style.width = '820px';
  folha.style.maxWidth = 'none';
  folha.style.margin = '0';
  folha.style.padding = '16px';

  try {
    await new Promise(function(resolve) {
      requestAnimationFrame(function() {
        requestAnimationFrame(resolve);
      });
    });

    const canvas = await html2canvas(folha, {
      scale: 2,
      backgroundColor: '#ffffff',
      useCORS: true,
      windowWidth: 900,
      windowHeight: Math.max(window.innerHeight, folha.scrollHeight + 100),

      onclone: function(doc) {
        const folhaClonada = doc.getElementById('folha');

        if (folhaClonada) {
          folhaClonada.style.width = '820px';
          folhaClonada.style.maxWidth = 'none';
          folhaClonada.style.margin = '0';
          folhaClonada.style.padding = '16px';
        }

        /* Campos de texto */
        doc.querySelectorAll('input[type="text"], input[type="email"]').forEach(function(inp) {
          const span = doc.createElement('span');
          span.textContent = inp.value || '\u00a0';
          span.style.cssText =
            'display:inline-block;max-width:100%;padding:2px;' +
            'font-size:12px;color:#103a6b;overflow-wrap:anywhere;';

          if (inp.parentElement && inp.parentElement.classList.contains('nome')) {
            span.style.textAlign = 'center';
            span.style.width = '100%';
          }

          inp.parentNode.replaceChild(span, inp);
        });

        /* Data */
        doc.querySelectorAll('input[type="date"]').forEach(function(inp) {
          const span = doc.createElement('span');
          span.textContent = inp.value ? inp.value.split('-').reverse().join('/') : '\u00a0';
          span.style.cssText =
            'display:inline-block;max-width:100%;padding:2px;' +
            'font-size:12px;color:#103a6b;overflow-wrap:anywhere;';
          inp.parentNode.replaceChild(span, inp);
        });

        /* Horas */
        doc.querySelectorAll('input[type="time"]').forEach(function(inp) {
          const span = doc.createElement('span');
          span.textContent = inp.value || '--:--';
          span.style.cssText =
            'display:block;width:100%;text-align:center;' +
            'font-size:14px;color:#103a6b;';
          inp.parentNode.replaceChild(span, inp);
        });

        /* Descrição do serviço */
        doc.querySelectorAll('textarea').forEach(function(textarea) {
          const texto = doc.createElement('div');
          texto.textContent = textarea.value || ' ';
          texto.style.cssText =
            'box-sizing:border-box;width:100%;min-height:120px;padding:4px;' +
            'font-size:12px;line-height:1.4;color:#103a6b;' +
            'white-space:pre-wrap;overflow-wrap:anywhere;';
          textarea.parentNode.replaceChild(texto, textarea);
        });

        /* Caixas assinaladas */
        doc.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
          const span = doc.createElement('span');
          span.textContent = cb.checked ? '☒ ' : '☐ ';
          span.style.cssText = 'font-size:12px;color:#103a6b;';
          cb.parentNode.replaceChild(span, cb);
        });

        /* Assinaturas */
        doc.querySelectorAll('canvas').forEach(function(cv, i) {
          const img = doc.createElement('img');
          img.src = assinaturas[i] || cv.toDataURL();
          img.style.cssText =
            'display:block;width:100%;height:75px;object-fit:contain;background:#fff;';
          cv.parentNode.replaceChild(img, cv);
        });

        doc.querySelectorAll('.btn-limpar, .botoes-fim').forEach(function(el) {
          el.style.display = 'none';
        });
      }
    });

    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF('p', 'mm', 'a4');

    const pagW = 210;
    const pagH = 297;
    const margem = 6;
    const areaW = pagW - margem * 2;
    const areaH = pagH - margem * 2;
    const pxParaMm = 25.4 / 96;

    const larguraCanvasMm = canvas.width * pxParaMm;
    const alturaCanvasMm = canvas.height * pxParaMm;

    /* Redimensiona proporcionalmente para caber numa folha A4 */
    const escala = Math.min(
      areaW / larguraCanvasMm,
      areaH / alturaCanvasMm
    );

    const imgWmm = larguraCanvasMm * escala;
    const imgHmm = alturaCanvasMm * escala;
    const x = (pagW - imgWmm) / 2;
    const y = margem;

    pdf.addImage(
      canvas.toDataURL('image/jpeg', 0.92),
      'JPEG',
      x,
      y,
      imgWmm,
      imgHmm
    );

    return pdf;
  } finally {
    if (estiloOriginal === null) {
      folha.removeAttribute('style');
    } else {
      folha.setAttribute('style', estiloOriginal);
    }
  }
}

/* Enviar PDF por email ou abrir a partilha do telemóvel */
async function enviarPDFporEmail() {
  document.getElementById('overlay').style.display = 'flex';

  try {
    const pdf = await gerarPDF();

    const nomeFicheiro =
      'Relatorio_' +
      (v('nome') ? v('nome').trim().replace(/\s+/g, '_') : 'Assistencia') +
      (v('data') ? '_' + v('data') : '') +
      '.pdf';

    const assunto =
      'Relatório de Assistência — ' +
      (v('nome') || 'Cliente') +
      (v('data') ? ' — ' + dataFmt(v('data')) : '');

    const corpo =
      'Exmos. Senhores,\n\n' +
      'Segue em anexo o relatório de assistência técnica' +
      (v('data') ? ' de ' + dataFmt(v('data')) : '') +
      '.\n\nCom os melhores cumprimentos,\n' +
      (v('nomeTecnico') || 'SE & S') +
      '\nSE & S — Segurança Electronica e Serviços\n' +
      'Tel.: (+351) 912 501 599 · geral@se-s.pt';

    const blob = pdf.output('blob');
    const ficheiro = new File([blob], nomeFicheiro, {
      type: 'application/pdf'
    });

    /* Telemóvel: partilha nativa com o PDF anexado */
    if (navigator.canShare && navigator.canShare({ files: [ficheiro] })) {
      document.getElementById('overlay').style.display = 'none';

      try {
        await navigator.share({
          files: [ficheiro],
          title: assunto,
          text: corpo
        });
      } catch (e) {
        /* A partilha foi cancelada pelo utilizador */
      }

      return;
    }

    /* Computador: descarrega o PDF e abre o email */
    pdf.save(nomeFicheiro);

    const mailto =
      'mailto:' + encodeURIComponent(v('email')) +
      '?cc=' + encodeURIComponent('geral@se-s.pt') +
      '&subject=' + encodeURIComponent(assunto) +
      '&body=' + encodeURIComponent(
        corpo + '\n\n⚠️ ANEXA o ficheiro PDF: ' +
        nomeFicheiro + ' (está nas Transferências)'
      );

    document.getElementById('overlay').style.display = 'none';
    window.location.href = mailto;

    setTimeout(function() {
      alert(
        '📎 O PDF foi descarregado para as Transferências.\n\n' +
        'Anexa o ficheiro "' + nomeFicheiro + '" ao email que abriu.'
      );
    }, 800);
  } catch (e) {
    document.getElementById('overlay').style.display = 'none';
    alert('❌ Erro ao gerar o PDF. Tenta novamente.\n\n' + e.message);
    console.error(e);
  }
}

/* Assinatura no ecrã */
function iniciarCanvas(id) {
  const cv = document.getElementById(id);
  const rect = cv.getBoundingClientRect();

  cv.width = Math.max(1, Math.round(rect.width));
  cv.height = Math.max(1, Math.round(rect.height));

  const ctx = cv.getContext('2d');
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  ctx.strokeStyle = '#103a6b';

  let desenhar = false;

  function pos(e) {
    const r = cv.getBoundingClientRect();

    return {
      x: (e.clientX - r.left) * (cv.width / r.width),
      y: (e.clientY - r.top) * (cv.height / r.height)
    };
  }

  cv.addEventListener('pointerdown', function(e) {
    desenhar = true;
    cv.setPointerCapture(e.pointerId);

    const p = pos(e);
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    e.preventDefault();
  });

  cv.addEventListener('pointermove', function(e) {
    if (!desenhar) return;

    const p = pos(e);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    e.preventDefault();
  });

  function terminarDesenho() {
    if (!desenhar) return;
    desenhar = false;
    guardarRascunho();
  }

  cv.addEventListener('pointerup', terminarDesenho);
  cv.addEventListener('pointercancel', terminarDesenho);
}

function limparCanvas(id) {
  const cv = document.getElementById(id);
  cv.getContext('2d').clearRect(0, 0, cv.width, cv.height);
  guardarRascunho();
}

/* Início */
window.addEventListener('load', function() {
  iniciarCanvas('cvTec');
  iniciarCanvas('cvCli');

  let rascunho = null;

  try {
    rascunho = JSON.parse(localStorage.getItem('ra_rascunho') || 'null');
  } catch (e) {
    rascunho = null;
  }

  if (rascunho && rascunho.dados) {
    relId = rascunho.relId || null;
    preencherDados(rascunho.dados);
  } else {
    document.getElementById('nomeTecnico').value = 'João Gonçalves';
    document.getElementById('data').valueAsDate = new Date();
  }
});
